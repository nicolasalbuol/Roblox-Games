          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">BotRenderer</string>
              <string name="Source"><![CDATA[-- Draws server bots locally from compact position packets, with smoothing and a squishy bob.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local State = require(script.Parent.State)

local FLOOR = Config.Grid.FloorY
local BotRenderer = { bots = {} }

local function newPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	for k, v in props do
		p[k] = v
	end
	return p
end

function BotRenderer:_create(slot: number)
	local model = Instance.new("Model")
	model.Name = "Bot_" .. slot
	local body = newPart({ Name = "Body", Shape = Enum.PartType.Ball, Size = Vector3.one * 3.4, Material = Enum.Material.SmoothPlastic, Color = State:ColorOf(slot), Parent = model })
	local eyes = {}
	for _, side in { -0.55, 0.55 } do
		local eye = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, Color = Color3.new(1, 1, 1), Parent = model })
		local pupil = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.45, Color = Color3.fromRGB(20, 20, 30), Parent = model })
		table.insert(eyes, { eye, Vector3.new(side, 0.45, -1.45) })
		table.insert(eyes, { pupil, Vector3.new(side, 0.45, -1.85) })
	end
	model.PrimaryPart = body
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 30)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.MaxDistance = 140
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = State:ColorOf(slot)
	t.TextStrokeTransparency = 0.25
	t.Text = State:NameOf(slot)
	t.Parent = bb
	bb.Parent = body
	model.Parent = workspace
	return { model = model, body = body, eyes = eyes, label = t, pos = nil, target = nil, alive = false, yaw = 0 }
end

function BotRenderer:_sync()
	for slot, b in self.bots do
		local e = State.bySlot[slot]
		if not e or not e.isBot then
			b.model:Destroy()
			self.bots[slot] = nil
		else
			b.body.Color = e.color3
			b.label.TextColor3 = e.color3
			b.label.Text = e.name
		end
	end
end

function BotRenderer:Start()
	State.RosterChanged:Connect(function()
		self:_sync()
	end)
	Net.BotPos.OnClientEvent:Connect(function(buf)
		local count = buffer.readu8(buf, 0)
		for k = 1, count do
			local o = 1 + (k - 1) * 10
			local slot = buffer.readu8(buf, o)
			local e = State.bySlot[slot]
			if e and e.isBot then
				local b = self.bots[slot] or self:_create(slot)
				self.bots[slot] = b
				local target = Vector3.new(buffer.readf32(buf, o + 2), FLOOR, buffer.readf32(buf, o + 6))
				local alive = buffer.readu8(buf, o + 1) == 1
				if alive and (not b.alive or not b.pos or (target - b.pos).Magnitude > 20) then
					b.pos = target -- respawn / teleport: snap
				end
				b.alive, b.target = alive, target
				b.model.Parent = if alive then workspace else nil
			end
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		for _, b in self.bots do
			if b.alive and b.pos and b.target then
				local prev = b.pos
				b.pos = prev:Lerp(b.target, 1 - math.exp(-12 * dt))
				local move = b.pos - prev
				if move.Magnitude > 0.01 then
					b.yaw = math.atan2(-move.X, -move.Z)
				end
				local bob = if move.Magnitude > 0.01 then math.abs(math.sin(t * 12)) * 0.5 else 0
				local root = CFrame.new(b.pos + Vector3.new(0, 1.7 + bob, 0)) * CFrame.Angles(0, b.yaw, 0)
				b.body.CFrame = root
				for _, pair in b.eyes do
					pair[1].CFrame = root * CFrame.new(pair[2])
				end
			end
		end
	end)
end

return BotRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[-- Top-down follow camera while playing (territory readability), normal Roblox camera in the hub.
-- Mouse wheel / pinch zooms. Setting "classic" keeps the default camera everywhere.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local State = require(script.Parent.State)

local LocalPlayer = Players.LocalPlayer
local CameraController = { height = 62, shake = 0, mode = "top" }

local MIN_H, MAX_H = 34, 95

function CameraController:Shake(amount: number)
	self.shake = math.max(self.shake, amount)
end

function CameraController:SetMode(mode: string)
	self.mode = mode
end

function CameraController:Start()
	UserInputService.InputChanged:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseWheel then
			self.height = math.clamp(self.height - input.Position.Z * 5, MIN_H, MAX_H)
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)
		if not processed and state == Enum.UserInputState.Change then
			self.height = math.clamp(self.height / math.clamp(scale, 0.9, 1.1), MIN_H, MAX_H)
		end
	end)

	local wasActive = false
	RunService:BindToRenderStep("ChromaCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = workspace.CurrentCamera
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local roundState = State:RoundState()
		local active = self.mode == "top" and State.mySlot ~= nil and roundState == "Playing" and root ~= nil
		if active then
			cam.CameraType = Enum.CameraType.Scriptable
			local focus = root.Position
			local goal = CFrame.lookAt(focus + Vector3.new(0, self.height, self.height * 0.5), focus)
			if self.shake > 0.01 then
				goal *= CFrame.new((math.random() - 0.5) * self.shake, (math.random() - 0.5) * self.shake, 0)
				self.shake *= math.exp(-8 * dt)
			end
			cam.CFrame = if wasActive then cam.CFrame:Lerp(goal, 1 - math.exp(-12 * dt)) else goal
		elseif wasActive then
			cam.CameraType = Enum.CameraType.Custom
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				cam.CameraSubject = hum
			end
		end
		wasActive = active
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[-- Juice: capture bursts, splats, pickups, spinning power-ups, reduced-effects mode.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.State)
local SoundController = require(script.Parent.SoundController)
local CameraController = require(script.Parent.CameraController)

local LocalPlayer = Players.LocalPlayer
local EffectsController = { reduced = false, pool = {}, poolIndex = 0 }

local POOL = 6

function EffectsController:_emitter()
	self.poolIndex = self.poolIndex % POOL + 1
	return self.pool[self.poolIndex]
end

function EffectsController:Burst(pos: Vector3, color: Color3, count: number)
	if self.reduced then
		count = math.floor(count / 3)
	end
	if count <= 0 then
		return
	end
	local e = self:_emitter()
	e.part.Position = pos
	e.emitter.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.6))
	e.emitter:Emit(count)
end

function EffectsController:SetReduced(on: boolean)
	self.reduced = on
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Enabled = not on
	end
	for _, inst in CollectionService:GetTagged("CosmeticFX") do
		if not inst:IsA("Attachment") then
			inst.Enabled = not on
		end
	end
end

local function myPosition(): Vector3?
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return root and root.Position
end

function EffectsController:Start()
	for _ = 1, POOL do
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.one
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.5, 0.9)
		emitter.Speed = NumberRange.new(14, 26)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, -50, 0)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) })
		emitter.LightEmission = 0.6
		emitter.Parent = part
		part.Parent = workspace
		table.insert(self.pool, { part = part, emitter = emitter })
	end

	CollectionService:GetInstanceAddedSignal("CosmeticFX"):Connect(function(inst)
		if self.reduced and not inst:IsA("Attachment") then
			inst.Enabled = false
		end
	end)

	State.MatchEvent:Connect(function(evt)
		if evt.t == "capture" then
			local pos = myPosition()
			if pos then
				self:Burst(pos, State:ColorOf(State.mySlot or 0), math.clamp(evt.n // 2, 12, 60))
			end
			SoundController:Play("Capture", 1, 1 + math.clamp(evt.n / 300, 0, 0.5))
			CameraController:Shake(math.clamp(evt.n / 60, 0.3, 1.6))
		elseif evt.t == "elim" then
			local pos = Vector3.new(evt.x, Config.Grid.FloorY + 2, evt.z)
			self:Burst(pos, State:ColorOf(evt.victim), 50)
			if evt.victim == State.mySlot then
				SoundController:Play("Splat")
				CameraController:Shake(2.5)
			elseif evt.killer == State.mySlot then
				SoundController:Play("Splat", 0.7, 1.3)
			end
		elseif evt.t == "powerup" and evt.slot == State.mySlot then
			SoundController:Play("Pickup", 1, 1.4)
		elseif evt.t == "roundStart" then
			SoundController:Play("RoundStart", 1, 0.8)
		end
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for _, p in CollectionService:GetTagged("Powerup") do
			if p:IsA("BasePart") then
				local base = p:GetAttribute("BaseY")
				if not base then
					base = p.Position.Y
					p:SetAttribute("BaseY", base)
				end
				p.CFrame = CFrame.new(p.Position.X, base + math.sin(t * 3) * 0.6, p.Position.Z) * CFrame.Angles(0, t * 2, 0)
			end
		end
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">GridRenderer</string>
              <string name="Source"><![CDATA[-- Renders the territory grid locally: one cheap non-colliding tile per cell, recoloured on deltas.
-- Newly claimed tiles do a short "pop" wave (moved in bulk, skipped with Reduced Effects).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Maps = require(ReplicatedStorage.Shared.Maps)
local State = require(script.Parent.State)

local G = Config.Grid
local GridRenderer = { tiles = {}, base = {}, pops = {}, reducedFx = false }

local BLACK, WHITE = Color3.new(0, 0, 0), Color3.new(1, 1, 1)
local POP_TIME, POP_HEIGHT, MAX_POPS = 0.35, 0.9, 260

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function GridRenderer:_build()
	local folder = Instance.new("Folder")
	folder.Name = "ChromaTiles"
	local size = Vector3.new(G.TileSize - 0.3, 0.2, G.TileSize - 0.3)
	for z = 1, G.Size do
		for x = 1, G.Size do
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.SmoothPlastic
			p.Size = size
			local cf = CFrame.new(G.OriginX + (x - 0.5) * G.TileSize, G.FloorY + 0.1, G.OriginZ + (z - 0.5) * G.TileSize)
			p.CFrame = cf
			p.Parent = folder
			local i = (z - 1) * G.Size + x
			self.tiles[i] = p
			self.base[i] = cf
		end
	end
	folder.Parent = workspace
	self.folder = folder
end

function GridRenderer:_paint(i: number)
	local grid, part = State.grid, self.tiles[i]
	local o, t = grid.owner[i], grid.trail[i]
	if o == -1 then
		part.Transparency = 1
		return
	end
	part.Transparency = 0
	local x, z = grid:coords(i)
	local alt = (x + z) % 2 == 0
	if t ~= 0 then
		part.Material = Enum.Material.Neon
		part.Color = State:ColorOf(t):Lerp(WHITE, 0.25)
	elseif o > 0 then
		part.Material = Enum.Material.SmoothPlastic
		local c = State:ColorOf(o)
		part.Color = if alt then c else c:Lerp(BLACK, 0.12)
	else
		part.Material = Enum.Material.SmoothPlastic
		part.Color = if alt then self.tileA else self.tileB
	end
end

function GridRenderer:_paintAll()
	if not State.grid then
		return
	end
	for i = 1, State.grid.n do
		self:_paint(i)
	end
end

function GridRenderer:_pop(i: number)
	if self.reducedFx or #self.pops >= MAX_POPS then
		return
	end
	table.insert(self.pops, { i = i, t0 = os.clock() })
end

function GridRenderer:_stepPops()
	local n = #self.pops
	if n == 0 then
		return
	end
	local now = os.clock()
	local parts, cfs, keep = table.create(n), table.create(n), {}
	for _, e in self.pops do
		local a = (now - e.t0) / POP_TIME
		local base = self.base[e.i]
		if a >= 1 then
			parts[#parts + 1] = self.tiles[e.i]
			cfs[#cfs + 1] = base
		else
			parts[#parts + 1] = self.tiles[e.i]
			cfs[#cfs + 1] = base + Vector3.new(0, math.sin(a * math.pi) * POP_HEIGHT, 0)
			keep[#keep + 1] = e
		end
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	self.pops = keep
end

function GridRenderer:SetReducedFx(on: boolean)
	self.reducedFx = on
end

function GridRenderer:Start()
	self:_build()
	local function applyMap(mapId)
		local map = Maps.get(mapId) or Maps.List[1]
		self.tileA, self.tileB = rgb(map.tileA), rgb(map.tileB)
	end
	applyMap(Maps.List[1].id)
	State.GridReset:Connect(function(mapId)
		applyMap(mapId)
		self:_paintAll()
	end)
	State.RosterChanged:Connect(function()
		self:_paintAll()
	end)
	State.GridChanged:Connect(function(changed)
		local grid = State.grid
		for _, i in changed do
			local wasTrail = self.tiles[i].Material == Enum.Material.Neon
			self:_paint(i)
			-- Capture wave: trail turned into territory, or a big batch of new territory.
			if (wasTrail or #changed > 40) and grid.owner[i] > 0 and grid.trail[i] == 0 then
				self:_pop(i)
			end
		end
	end)
	RunService.RenderStepped:Connect(function()
		self:_stepPops()
	end)
end

return GridRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[-- Local SFX/music with volume from saved settings. IDs come from Config.Audio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)

local SoundController = { sfx = 0.8, music = 0.5, cache = {} }

function SoundController:Play(name: string, scale: number?, pitch: number?)
	local id = Config.Audio[name]
	if not id or id == "" or self.sfx <= 0 then
		return
	end
	local s = self.cache[name]
	if not s then
		s = Instance.new("Sound")
		s.Name = "SFX_" .. name
		s.SoundId = id
		s.Parent = SoundService
		self.cache[name] = s
	end
	s.Volume = self.sfx * 0.6 * (scale or 1)
	s.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(s)
end

function SoundController:SetVolumes(sfx: number, music: number)
	self.sfx, self.music = sfx, music
	if self.musicSound then
		self.musicSound.Volume = music * 0.35
	end
end

function SoundController:Start()
	if Config.Audio.Music ~= "" then
		local m = Instance.new("Sound")
		m.Name = "Music"
		m.SoundId = Config.Audio.Music
		m.Looped = true
		m.Volume = self.music * 0.35
		m.Parent = SoundService
		m:Play()
		self.musicSound = m
	end
end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[-- Client-side mirror of server state + signals. The client never decides outcomes.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Grid = require(ReplicatedStorage.Shared.Grid)
local GridCodec = require(ReplicatedStorage.Shared.GridCodec)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Net = require(ReplicatedStorage.Shared.Net)

local LocalPlayer = Players.LocalPlayer

local State = {
	profile = nil,
	passes = {},
	roster = {},
	bySlot = {},
	mySlot = nil,
	mapId = nil,
	grid = nil,
	ProfileChanged = Signal.new(),
	RosterChanged = Signal.new(),
	GridReset = Signal.new(),
	GridChanged = Signal.new(),
	MatchEvent = Signal.new(),
	Notify = Signal.new(),
}

local GRAY = Color3.fromRGB(120, 120, 140)

function State:ColorOf(slot: number): Color3
	local e = self.bySlot[slot]
	return e and e.color3 or GRAY
end

function State:NameOf(slot: number): string
	local e = self.bySlot[slot]
	return e and e.name or "?"
end

function State:RoundState(): (string, number)
	return workspace:GetAttribute("RoundState") or "Intermission", workspace:GetAttribute("RoundEndsAt") or 0
end

function State:Request(action: string, arg: any)
	local ok, res = pcall(Net.Request.InvokeServer, Net.Request, action, arg)
	if not ok or type(res) ~= "table" then
		return { ok = false, err = "network" }
	end
	return res
end

function State:Event(kind: string, arg: any)
	Net.ClientEvent:FireServer(kind, arg)
end

function State:Start()
	Net.Profile.OnClientEvent:Connect(function(data, passes)
		self.profile = data
		self.passes = passes or {}
		self.ProfileChanged:Fire(data)
	end)
	Net.Roster.OnClientEvent:Connect(function(list)
		self.roster, self.bySlot, self.mySlot = list, {}, nil
		for _, e in list do
			e.color3 = Color3.fromRGB(e.color[1], e.color[2], e.color[3])
			self.bySlot[e.slot] = e
			if not e.isBot and e.userId == LocalPlayer.UserId then
				self.mySlot = e.slot
			end
		end
		self.RosterChanged:Fire()
	end)
	Net.GridSnapshot.OnClientEvent:Connect(function(mapId, buf)
		local g = Grid.new(Config.Grid.Size)
		GridCodec.applySnapshot(g, buf)
		g:takeDirty()
		self.grid, self.mapId = g, mapId
		self.GridReset:Fire(mapId)
	end)
	Net.GridDelta.OnClientEvent:Connect(function(buf)
		if self.grid then
			local changed = GridCodec.applyDelta(self.grid, buf)
			self.grid:takeDirty()
			self.GridChanged:Fire(changed)
		end
	end)
	Net.Match.OnClientEvent:Connect(function(evt)
		self.MatchEvent:Fire(evt)
	end)
	Net.Notify.OnClientEvent:Connect(function(text, style)
		self.Notify:Fire(text, style)
	end)
end

return State
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="45">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client bootstrap.
local ContextActionService = game:GetService("ContextActionService")

local Controllers = script.Parent.Controllers
local UI = script.Parent.UI

local State = require(Controllers.State)
local GridRenderer = require(Controllers.GridRenderer)
local BotRenderer = require(Controllers.BotRenderer)
local CameraController = require(Controllers.CameraController)
local SoundController = require(Controllers.SoundController)
local EffectsController = require(Controllers.EffectsController)

local Kit = require(UI.Kit)
local HUD = require(UI.HUD)
local Shop = require(UI.Shop)
local Quests = require(UI.Quests)
local Results = require(UI.Results)
local Settings = require(UI.Settings)
local Onboarding = require(UI.Onboarding)

State:Start()
GridRenderer:Start()
BotRenderer:Start()
CameraController:Start()
SoundController:Start()
EffectsController:Start()

local gui = Kit.root("ChromaUI")
HUD:Start(gui, Kit.openModal)
Shop:Start(gui)
Quests:Start(gui)
Results:Start(gui)
Settings:Start(gui)
Onboarding:Start(gui)

State.ProfileChanged:Connect(function(data)
	local s = data.settings
	SoundController:SetVolumes(s.sfx, s.music)
	CameraController:SetMode(s.camera)
	EffectsController:SetReduced(s.reducedFx)
	GridRenderer:SetReducedFx(s.reducedFx)
end)

-- Keyboard / gamepad shortcuts.
local function bind(name: string, modal: string, ...)
	ContextActionService:BindAction(name, function(_, state)
		if state == Enum.UserInputState.Begin then
			Kit.openModal(modal)
		end
		return Enum.ContextActionResult.Sink
	end, false, ...)
end
bind("ChromaShop", "Shop", Enum.KeyCode.B, Enum.KeyCode.ButtonY)
bind("ChromaQuests", "Quests", Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
ContextActionService:BindAction("ChromaClose", function(_, state)
	if Kit.currentModal() then
		if state == Enum.UserInputState.Begin then
			Kit.closeModal()
		end
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.ButtonB)

-- Ask for state only once every listener is connected.
State:Event("ready")
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="46">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- In-game HUD: round timer, coins/level, live turf leaderboard, menu, big toasts, kill feed, power-up chips.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Progression = require(ReplicatedStorage.Shared.Progression)
local Maps = require(ReplicatedStorage.Shared.Maps)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local T = Kit.Theme
local LocalPlayer = Players.LocalPlayer
local HUD = {}

local ROWS = 6

function HUD:_top(gui)
	local pill = Kit.new("Frame", {
		Size = UDim2.fromOffset(380, 58),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, { Kit.corner(29), Kit.stroke(T.Sky, 2.5, 0.25) })
	self.timer = Kit.label({ Size = UDim2.new(1, -24, 0.62, 0), Position = UDim2.fromOffset(12, 4), MaxText = 32, Parent = pill })
	self.mapLabel = Kit.label({ Size = UDim2.new(1, -24, 0.34, 0), Position = UDim2.new(0, 12, 0.62, -2), Font = T.Bold, TextColor3 = T.Sub, MaxText = 15, Parent = pill })
end

function HUD:_wallet(gui)
	local box = Kit.new("Frame", { Size = UDim2.fromOffset(250, 100), Position = UDim2.fromOffset(12, 10), BackgroundTransparency = 1, Parent = gui })
	local coins = Kit.new("Frame", { Size = UDim2.fromOffset(200, 44), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, Parent = box }, { Kit.corner(22), Kit.stroke(T.Gold, 2, 0.3) })
	Kit.new("Frame", { Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(8, 7), BackgroundColor3 = T.Gold, Parent = coins }, { Kit.corner(15), Kit.stroke(Color3.fromRGB(180, 120, 20), 2, 0) })
	self.coins = Kit.label({ Size = UDim2.new(1, -54, 1, -10), Position = UDim2.fromOffset(46, 5), TextXAlignment = Enum.TextXAlignment.Left, Text = "0", MaxText = 26, Parent = coins })

	local lvl = Kit.new("Frame", { Size = UDim2.fromOffset(240, 44), Position = UDim2.fromOffset(0, 52), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, Parent = box }, { Kit.corner(22), Kit.stroke(T.Mint, 2, 0.3) })
	local badge = Kit.new("Frame", { Size = UDim2.fromOffset(36, 36), Position = UDim2.fromOffset(4, 4), BackgroundColor3 = T.Mint, Parent = lvl }, { Kit.corner(18) })
	self.level = Kit.label({ Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), TextColor3 = Color3.fromRGB(20, 40, 40), Text = "1", Parent = badge })
	local barBg = Kit.new("Frame", { Size = UDim2.new(1, -60, 0, 14), Position = UDim2.new(0, 48, 0.5, -7), BackgroundColor3 = T.Bg, Parent = lvl }, { Kit.corner(7) })
	self.xpBar = Kit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Mint, Parent = barBg }, { Kit.corner(7), Kit.gradient(T.Mint, T.Sky, 0) })
end

function HUD:_board(gui)
	local board = Kit.new("Frame", {
		Size = UDim2.fromOffset(250, 40 + ROWS * 34),
		Position = UDim2.new(1, -12, 0, 10),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, { Kit.corner(16), Kit.stroke(T.Pink, 2, 0.35) })
	Kit.label({ Text = "TURF", Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 6), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = board })
	self.rows = {}
	for k = 1, ROWS do
		local row = Kit.new("Frame", { Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 36 + (k - 1) * 34), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.3, Visible = false, Parent = board }, { Kit.corner(8) })
		local fill = Kit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundTransparency = 0.45, Parent = row }, { Kit.corner(8) })
		local name = Kit.label({ Size = UDim2.new(0.7, -8, 1, -6), Position = UDim2.fromOffset(8, 3), Font = T.Bold, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16, Parent = row })
		local pct = Kit.label({ Size = UDim2.new(0.3, -8, 1, -6), Position = UDim2.new(0.7, 0, 0, 3), TextXAlignment = Enum.TextXAlignment.Right, MaxText = 17, Parent = row })
		self.rows[k] = { row = row, fill = fill, name = name, pct = pct }
	end
	self.board = board
	self.feed = Kit.new("Frame", { Size = UDim2.fromOffset(300, 120), Position = UDim2.new(1, -12, 0, 60 + ROWS * 34), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Parent = gui }, { Kit.list(4, false, Enum.HorizontalAlignment.Right) })
end

function HUD:_menu(gui, open)
	local bar = Kit.new("Frame", { Size = UDim2.fromOffset(96, 330), Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, Parent = gui }, { Kit.list(10) })
	local defs = {
		{ "SHOP", T.Gold, "Shop" },
		{ "QUESTS", T.Mint, "Quests" },
		{ "INVITE", T.Sky, nil },
		{ "SETTINGS", T.PanelLight, "Settings" },
	}
	for k, d in defs do
		local btn = Kit.button({
			text = d[1],
			color = d[2],
			size = UDim2.fromOffset(96, 66),
			textColor = if d[1] == "SETTINGS" then T.Text else nil,
			maxText = 18,
			layoutOrder = k,
			parent = bar,
			onClick = function()
				if d[3] then
					open(d[3])
				else
					self:_invite()
				end
			end,
		})
		if d[1] == "QUESTS" then
			self.questDot = Kit.new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -10, 0, -6), BackgroundColor3 = T.Red, Visible = false, Parent = btn }, { Kit.corner(9), Kit.stroke(Color3.new(1, 1, 1), 2, 0) })
		end
	end
end

function HUD:_invite()
	State:Event("invite")
	local ok, can = pcall(SocialService.CanSendGameInviteAsync, SocialService, LocalPlayer)
	if ok and can then
		pcall(SocialService.PromptGameInvite, SocialService, LocalPlayer)
	else
		State.Notify:Fire("Invites aren't available on this device right now.", "info")
	end
end

function HUD:_center(gui)
	self.big = Kit.label({ Size = UDim2.fromOffset(600, 90), Position = UDim2.fromScale(0.5, 0.3), AnchorPoint = Vector2.new(0.5, 0.5), TextTransparency = 1, TextStrokeTransparency = 1, MaxText = 72, Parent = gui })
	self.bigScale = Kit.new("UIScale", { Parent = self.big })
	self.overlay = Kit.new("Frame", { Size = UDim2.fromOffset(520, 130), Position = UDim2.fromScale(0.5, 0.55), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.15, Visible = false, Parent = gui }, { Kit.corner(20), Kit.stroke(T.Red, 3, 0.1) })
	self.overlayTitle = Kit.label({ Size = UDim2.new(1, -20, 0.55, 0), Position = UDim2.fromOffset(10, 8), TextColor3 = T.Red, MaxText = 40, Parent = self.overlay })
	self.overlaySub = Kit.label({ Size = UDim2.new(1, -20, 0.35, 0), Position = UDim2.new(0, 10, 0.58, 0), Font = T.Bold, TextColor3 = T.Sub, MaxText = 22, Parent = self.overlay })
	self.chips = Kit.new("Frame", { Size = UDim2.fromOffset(400, 40), Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = gui }, { Kit.list(8, true) })
end

function HUD:BigToast(text: string, color: Color3?)
	local l = self.big
	l.Text = text
	l.TextColor3 = color or T.Text
	l.TextTransparency, l.TextStrokeTransparency = 0, 0.2
	self.bigScale.Scale = 0.5
	Kit.tween(self.bigScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	self.bigToken = (self.bigToken or 0) + 1
	local token = self.bigToken
	task.delay(1.1, function()
		if self.bigToken == token then
			Kit.tween(l, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

function HUD:Feed(text: string, color: Color3?)
	local l = Kit.label({ Size = UDim2.fromOffset(300, 24), Text = text, Font = T.Bold, TextColor3 = color or T.Text, TextStrokeTransparency = 0.3, TextXAlignment = Enum.TextXAlignment.Right, MaxText = 17, Parent = self.feed })
	local items = {}
	for _, c in self.feed:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(items, c)
		end
	end
	if #items > 4 then
		items[1]:Destroy()
	end
	task.delay(4, function()
		if l.Parent then
			Kit.tween(l, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 }).Completed:Wait()
			l:Destroy()
		end
	end)
end

function HUD:Chip(text: string, color: Color3, seconds: number)
	local chip = Kit.new("Frame", { Size = UDim2.fromOffset(130, 36), BackgroundColor3 = color, Parent = self.chips }, { Kit.corner(18), Kit.stroke(Color3.new(0, 0, 0), 2, 0.5) })
	local l = Kit.label({ Size = UDim2.new(1, -12, 1, -8), Position = UDim2.fromOffset(6, 4), TextColor3 = Color3.fromRGB(20, 20, 40), MaxText = 20, Parent = chip })
	local t0 = os.clock()
	task.spawn(function()
		while chip.Parent and os.clock() - t0 < seconds do
			l.Text = string.format("%s %.0fs", text, math.ceil(seconds - (os.clock() - t0)))
			task.wait(0.2)
		end
		chip:Destroy()
	end)
end

function HUD:_refreshProfile(data)
	self.coins.Text = Kit.comma(data.coins)
	self.level.Text = tostring(data.level)
	Kit.tween(self.xpBar, 0.3, { Size = UDim2.fromScale(math.clamp(data.xp / Progression.xpToNext(data.level), 0, 1), 1) })
	local today = Progression.dayNumber(os.time())
	local claimable = data.daily.lastDay < today
	for _, q in data.quests.list do
		local def = Progression.quest(q.id)
		if def and not q.claimed and q.progress >= def.goal then
			claimable = true
		end
	end
	self.questDot.Visible = claimable
end

function HUD:_refreshBoard()
	local grid = State.grid
	local roundState = State:RoundState()
	if not grid or roundState ~= "Playing" then
		self.board.Visible = false
		return
	end
	self.board.Visible = true
	local entries = {}
	for _, e in State.roster do
		table.insert(entries, { e = e, pct = grid:percentOf(e.slot) })
	end
	table.sort(entries, function(a, b)
		return a.pct > b.pct
	end)
	-- Always show the local player, even outside the top rows.
	local shown = {}
	for k = 1, math.min(ROWS, #entries) do
		shown[k] = entries[k]
	end
	local mine
	for k, entry in entries do
		if entry.e.slot == State.mySlot then
			mine = k
		end
	end
	if mine and mine > ROWS then
		shown[ROWS] = entries[mine]
	end
	for k, r in self.rows do
		local entry = shown[k]
		r.row.Visible = entry ~= nil
		if entry then
			local rank = if entry.e.slot == State.mySlot and mine then mine else k
			r.name.Text = rank .. ". " .. entry.e.name
			r.name.TextColor3 = if entry.e.slot == State.mySlot then T.Gold else T.Text
			r.pct.Text = string.format("%.1f%%", entry.pct)
			r.fill.BackgroundColor3 = entry.e.color3
			r.fill.Size = UDim2.fromScale(math.clamp(entry.pct / 50, 0.02, 1), 1)
		end
	end
end

function HUD:Start(gui, open)
	self:_top(gui)
	self:_wallet(gui)
	self:_board(gui)
	self:_menu(gui, open)
	self:_center(gui)

	State.ProfileChanged:Connect(function(data)
		self:_refreshProfile(data)
	end)

	State.MatchEvent:Connect(function(evt)
		if evt.t == "capture" then
			self:BigToast("+" .. evt.n .. " TILES", State:ColorOf(State.mySlot or 0):Lerp(Color3.new(1, 1, 1), 0.2))
		elseif evt.t == "elim" then
			local victim, killer = State:NameOf(evt.victim), evt.killer ~= 0 and State:NameOf(evt.killer)
			local vc = State:ColorOf(evt.victim)
			if evt.victim == State.mySlot then
				self.overlay.Visible = true
				self.overlayTitle.Text = if killer then "CUT BY " .. string.upper(killer) .. "!" else "SPLAT!"
				self.overlaySub.Text = if evt.reason == "self" then "You crossed your own trail. Respawning..." elseif evt.reason == "enclosed" then "Your trail got looped in. Respawning..." elseif evt.reason == "overrun" then "Your turf was swallowed. Respawning..." else "Respawning..."
			elseif evt.killer == State.mySlot then
				self:BigToast("SNAP! " .. victim, T.Gold)
			end
			if killer then
				self:Feed(killer .. "  cut  " .. victim, vc)
			end
		elseif evt.t == "spawn" and evt.slot == State.mySlot then
			self.overlay.Visible = false
		elseif evt.t == "powerup" and evt.slot == State.mySlot then
			if evt.kind == "Dash" then
				self:Chip("DASH", T.Gold, evt.duration)
			elseif evt.kind == "Shield" then
				self:Chip("SHIELD", T.Sky, evt.duration)
			else
				self:BigToast("INK BOMB!", T.Pink)
			end
		elseif evt.t == "roundStart" then
			self.overlay.Visible = false
			local map = Maps.get(evt.map)
			self:BigToast(if map then string.upper(map.name) else "GO!", T.Mint)
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local roundState, endsAt = State:RoundState()
		local left = endsAt - workspace:GetServerTimeNow()
		if roundState == "Playing" then
			self.timer.Text = Kit.formatTime(left)
			self.timer.TextColor3 = if left <= 15 then T.Red else T.Text
			self.mapLabel.Text = string.upper(workspace:GetAttribute("MapName") or "")
		else
			self.timer.Text = "NEXT ROUND " .. Kit.formatTime(left)
			self.timer.TextColor3 = T.Mint
			self.mapLabel.Text = "HUB - GET READY"
			self.overlay.Visible = false
		end
		self:_refreshBoard()
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- Tiny UI toolkit: theme, instance builder, styled buttons/panels, single-modal router, responsive scale.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local SoundController = require(script.Parent.Parent.Controllers.SoundController)

local Kit = {}

Kit.Theme = {
	Bg = Color3.fromRGB(22, 18, 44),
	Panel = Color3.fromRGB(34, 29, 66),
	PanelLight = Color3.fromRGB(50, 43, 92),
	Text = Color3.fromRGB(246, 244, 255),
	Sub = Color3.fromRGB(184, 178, 226),
	Mint = Color3.fromRGB(62, 240, 178),
	Sky = Color3.fromRGB(72, 170, 255),
	Pink = Color3.fromRGB(255, 92, 200),
	Gold = Color3.fromRGB(255, 202, 64),
	Red = Color3.fromRGB(255, 92, 92),
	Disabled = Color3.fromRGB(90, 86, 120),
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
}
local T = Kit.Theme

Kit.ROBUX = utf8.char(0xE002) -- Roblox's built-in Robux glyph

function Kit.new(class: string, props, children)
	local inst = Instance.new(class)
	local parent = props and props.Parent
	for k, v in props or {} do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, c in children or {} do
		c.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(r: number?)
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, r or 14) })
end

function Kit.stroke(color: Color3?, thickness: number?, transparency: number?)
	return Kit.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.pad(px: number)
	local u = UDim.new(0, px)
	return Kit.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Kit.gradient(a: Color3, b: Color3, rotation: number?)
	return Kit.new("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 90 })
end

function Kit.list(padding: number?, horizontal: boolean?, align)
	return Kit.new("UIListLayout", {
		Padding = UDim.new(0, padding or 8),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

function Kit.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = T.Title,
		TextColor3 = T.Text,
		TextScaled = true,
		Text = "",
	}
	for k, v in props do
		if k ~= "MaxText" then
			defaults[k] = v
		end
	end
	local l = Kit.new("TextLabel", defaults)
	Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxText or 34, MinTextSize = 9, Parent = l })
	return l
end

function Kit.tween(inst, time: number, goal, style)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

-- Styled button. opts: text, color, size, position, anchor, onClick, textColor, maxText, parent, layoutOrder
function Kit.button(opts)
	local scale = Kit.new("UIScale", { Scale = 1 })
	local btn = Kit.new("TextButton", {
		Name = opts.name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = opts.color or T.Mint,
		Size = opts.size or UDim2.fromOffset(160, 52),
		Position = opts.position or UDim2.new(),
		AnchorPoint = opts.anchor or Vector2.zero,
		Text = "",
		LayoutOrder = opts.layoutOrder or 0,
		Parent = opts.parent,
	}, {
		Kit.corner(opts.radius or 14),
		Kit.stroke(Color3.new(0, 0, 0), 2.5, 0.55),
		Kit.gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 215)),
		scale,
	})
	local label = Kit.label({
		Name = "Label",
		Size = UDim2.new(1, -16, 1, -10),
		Position = UDim2.fromOffset(8, 5),
		Text = opts.text or "",
		TextColor3 = opts.textColor or Color3.fromRGB(26, 22, 50),
		MaxText = opts.maxText or 26,
		Parent = btn,
	})
	btn.MouseEnter:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1.05 })
	end)
	btn.MouseLeave:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		Kit.tween(scale, 0.06, { Scale = 0.94 })
	end)
	btn.MouseButton1Up:Connect(function()
		Kit.tween(scale, 0.1, { Scale = 1.05 })
	end)
	btn.Activated:Connect(function()
		if btn:GetAttribute("Disabled") then
			return
		end
		SoundController:Play("Click", 0.5, 1.2)
		if opts.onClick then
			opts.onClick()
		end
	end)
	return btn, label
end

function Kit.setEnabled(btn, enabled: boolean, color: Color3?)
	btn:SetAttribute("Disabled", not enabled)
	btn.BackgroundColor3 = if enabled then (color or btn.BackgroundColor3) else T.Disabled
end

-- Root ScreenGui with responsive UIScale (designed at 1280x720, clamped for phones/4K).
function Kit.root(name: string, order: number?)
	local gui = Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 0,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local scale = Kit.new("UIScale", { Parent = gui })
	local function fit()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(vp.X / 1150, vp.Y / 640), 0.6, 1.35)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	return gui
end

-- Modal window with title and close button. Returns frame, content.
function Kit.panel(parent, title: string, size: UDim2)
	local frame = Kit.new("Frame", {
		Name = title,
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = T.Panel,
		Visible = false,
		Parent = parent,
	}, {
		Kit.corner(20),
		Kit.stroke(T.Sky, 3, 0.2),
		Kit.new("UIScale", { Name = "PopScale" }),
	})
	Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = T.PanelLight, Parent = frame }, {
		Kit.corner(20),
		Kit.gradient(T.PanelLight, T.Panel),
	})
	Kit.label({ Text = title, Size = UDim2.new(1, -140, 0, 44), Position = UDim2.fromOffset(24, 10), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 36, Parent = frame })
	local close = Kit.button({
		text = "X",
		color = T.Red,
		size = UDim2.fromOffset(48, 48),
		position = UDim2.new(1, -60, 0, 8),
		textColor = Color3.new(1, 1, 1),
		parent = frame,
		onClick = function()
			Kit.closeModal()
		end,
	})
	close.Name = "Close"
	local content = Kit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -32, 1, -84),
		Position = UDim2.fromOffset(16, 72),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	return frame, content
end

local modals, current = {}, nil

function Kit.registerModal(name: string, frame, onOpen)
	modals[name] = { frame = frame, onOpen = onOpen }
end

function Kit.openModal(name: string)
	if current == name then
		Kit.closeModal()
		return
	end
	Kit.closeModal()
	local m = modals[name]
	if not m then
		return
	end
	current = name
	if m.onOpen then
		m.onOpen()
	end
	local pop = m.frame:FindFirstChild("PopScale")
	if pop then
		pop.Scale = 0.85
		Kit.tween(pop, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	m.frame.Visible = true
	if GuiService:IsTenFootInterface() or game:GetService("UserInputService").GamepadEnabled then
		local close = m.frame:FindFirstChild("Close")
		GuiService.SelectedObject = close
	end
end

function Kit.closeModal()
	if current and modals[current] then
		modals[current].frame.Visible = false
	end
	current = nil
	GuiService.SelectedObject = nil
end

function Kit.currentModal(): string?
	return current
end

function Kit.formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Kit.comma(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Onboarding</string>
              <string name="Source"><![CDATA[-- Title splash (main menu), first-time tutorial coach, and toast notifications.
local Players = game:GetService("Players")

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local T = Kit.Theme
local Onboarding = {}

local STEPS = {
	[0] = { "WALK OUT OF YOUR ZONE", "Leaving your colored zone draws a glowing trail." },
	[1] = { "WALK OUT OF YOUR ZONE", "Leaving your colored zone draws a glowing trail." },
	[2] = { "NOW LOOP BACK HOME!", "Return to your zone to claim everything inside the loop." },
}

function Onboarding:_splash(gui)
	local splash = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Bg, ZIndex = 50, Active = true, Parent = gui }, {
		Kit.gradient(Color3.fromRGB(30, 22, 70), Color3.fromRGB(12, 10, 28), 90),
	})
	local logo = Kit.label({ Size = UDim2.fromOffset(760, 130), Position = UDim2.fromScale(0.5, 0.32), AnchorPoint = Vector2.new(0.5, 0.5), Text = "CHROMA TURF", MaxText = 110, ZIndex = 51, Parent = splash })
	Kit.new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, T.Mint), ColorSequenceKeypoint.new(0.5, T.Sky), ColorSequenceKeypoint.new(1, T.Pink) }), Parent = logo })
	Kit.new("UIStroke", { Thickness = 4, Color = Color3.fromRGB(10, 8, 24), Parent = logo })
	Kit.label({ Size = UDim2.fromOffset(700, 40), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5), Text = "Draw a loop. Claim the land. Cut their trail.", Font = T.Bold, TextColor3 = T.Sub, MaxText = 28, ZIndex = 51, Parent = splash })
	local status = Kit.label({ Size = UDim2.fromOffset(500, 30), Position = UDim2.fromScale(0.5, 0.75), AnchorPoint = Vector2.new(0.5, 0.5), Text = "Loading your save...", Font = T.Bold, TextColor3 = T.Sub, MaxText = 20, ZIndex = 51, Parent = splash })
	local play = Kit.button({ text = "PLAY", color = T.Mint, size = UDim2.fromOffset(260, 80), position = UDim2.fromScale(0.5, 0.62), anchor = Vector2.new(0.5, 0.5), maxText = 44, parent = splash, onClick = function()
		Kit.tween(splash, 0.35, { BackgroundTransparency = 1 })
		for _, d in splash:GetDescendants() do
			if d:IsA("GuiObject") then
				Kit.tween(d, 0.3, { BackgroundTransparency = 1 })
			end
			if d:IsA("TextLabel") then
				Kit.tween(d, 0.3, { TextTransparency = 1 })
			end
			if d:IsA("UIStroke") then
				Kit.tween(d, 0.3, { Transparency = 1 })
			end
		end
		task.delay(0.4, function()
			splash:Destroy()
		end)
	end })
	play.ZIndex = 52
	play.Visible = false
	local function ready()
		status.Text = if State.profile.sessions > 1 then "Welcome back, " .. Players.LocalPlayer.DisplayName .. "!" else "Welcome, " .. Players.LocalPlayer.DisplayName .. "!"
		play.Visible = true
	end
	if State.profile then
		ready()
	else
		local conn
		conn = State.ProfileChanged:Connect(function()
			conn.Disconnect()
			ready()
		end)
	end
end

function Onboarding:_coach(gui)
	local box = Kit.new("Frame", { Size = UDim2.fromOffset(560, 92), Position = UDim2.new(0.5, 0, 0, 78), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.1, Visible = false, Parent = gui }, { Kit.corner(18), Kit.stroke(T.Mint, 3, 0) })
	local title = Kit.label({ Size = UDim2.new(1, -24, 0, 42), Position = UDim2.fromOffset(12, 6), TextColor3 = T.Mint, MaxText = 32, Parent = box })
	local body = Kit.label({ Size = UDim2.new(1, -24, 0, 32), Position = UDim2.fromOffset(12, 50), Font = T.Bold, TextColor3 = T.Text, MaxText = 18, Parent = box })
	local celebrated = false
	local function update()
		local data = State.profile
		local playing = State:RoundState() == "Playing" and State.mySlot ~= nil
		if not data or data.tutorialDone then
			if data and data.tutorialDone and not celebrated and data.tutorialStep == 3 and box.Visible then
				celebrated = true
				title.Text, body.Text = "AWESOME! BIGGER LOOPS = MORE TURF", "Walk through a rival's trail to cut it - but guard yours!"
				task.delay(6, function()
					box.Visible = false
				end)
			elseif not celebrated then
				box.Visible = false
			end
			return
		end
		local step = STEPS[data.tutorialStep] or STEPS[0]
		title.Text, body.Text = step[1], step[2]
		box.Visible = playing
	end
	State.ProfileChanged:Connect(update)
	State.MatchEvent:Connect(update)
	State.RosterChanged:Connect(update)
end

local STYLE = {
	info = Kit.Theme.Sky,
	success = Kit.Theme.Mint,
	gold = Kit.Theme.Gold,
	level = Kit.Theme.Mint,
	unlock = Kit.Theme.Pink,
	achievement = Kit.Theme.Gold,
	quest = Kit.Theme.Mint,
}

function Onboarding:_toasts(gui)
	local stack = Kit.new("Frame", { Size = UDim2.fromOffset(420, 300), Position = UDim2.new(0.5, 0, 1, -70), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = gui }, {
		Kit.new("UIListLayout", { Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local n = 0
	State.Notify:Connect(function(text, style)
		n += 1
		local color = STYLE[style] or T.Sky
		local toast = Kit.new("Frame", { Size = UDim2.fromOffset(420, 46), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.05, LayoutOrder = n, Parent = stack }, { Kit.corner(14), Kit.stroke(color, 2.5, 0) })
		local l = Kit.label({ Size = UDim2.new(1, -20, 1, -10), Position = UDim2.fromOffset(10, 5), Text = text, Font = T.Bold, TextColor3 = color, TextWrapped = true, MaxText = 18, Parent = toast })
		local items = {}
		for _, c in stack:GetChildren() do
			if c:IsA("Frame") then
				table.insert(items, c)
			end
		end
		if #items > 4 then
			items[1]:Destroy()
		end
		task.delay(3.5, function()
			if toast.Parent then
				Kit.tween(toast, 0.4, { BackgroundTransparency = 1 })
				Kit.tween(l, 0.4, { TextTransparency = 1 })
				task.wait(0.45)
				toast:Destroy()
			end
		end)
	end)
end

function Onboarding:Start(gui)
	self:_toasts(gui)
	self:_coach(gui)
	self:_splash(gui)
end

return Onboarding
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[-- Daily reward, daily quests, achievements and lifetime stats.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Progression = require(ReplicatedStorage.Shared.Progression)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local T = Kit.Theme
local Quests = {}

function Quests:Render()
	local data = State.profile
	if not data then
		return
	end
	for _, c in self.list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local order = 0
	local function row(height: number)
		order += 1
		return Kit.new("Frame", { Size = UDim2.new(1, -12, 0, height), BackgroundColor3 = T.PanelLight, LayoutOrder = order, Parent = self.list }, { Kit.corner(14) })
	end

	-- Daily reward
	local today = Progression.dayNumber(os.time())
	local canClaim, step, coins = Progression.dailyStatus(data.daily, today)
	local daily = row(80)
	Kit.label({ Size = UDim2.new(0.62, 0, 0, 34), Position = UDim2.fromOffset(16, 8), Text = "DAILY GIFT - DAY " .. step .. " of " .. #Config.Economy.DailyRewards, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold, MaxText = 22, Parent = daily })
	Kit.label({ Size = UDim2.new(0.62, 0, 0, 24), Position = UDim2.fromOffset(16, 44), Text = if canClaim then Kit.comma(coins) .. " coins waiting for you" else "Claimed! New gift tomorrow (missing a day never resets)", Font = T.Body, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 15, Parent = daily })
	local dailyBtn = Kit.button({ text = if canClaim then "CLAIM" else "DONE", color = T.Gold, size = UDim2.fromOffset(150, 52), position = UDim2.new(1, -166, 0.5, -26), parent = daily, onClick = function()
		local res = State:Request("claimDaily")
		if res.ok then
			State.Notify:Fire("+" .. res.coins .. " coins!", "gold")
		end
	end })
	Kit.setEnabled(dailyBtn, canClaim, T.Gold)

	-- Quests
	for _, q in data.quests.list do
		local def = Progression.quest(q.id)
		if def then
			local r = row(84)
			Kit.label({ Size = UDim2.new(0.62, 0, 0, 30), Position = UDim2.fromOffset(16, 8), Text = def.text, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22, Parent = r })
			local barBg = Kit.new("Frame", { Size = UDim2.new(0.55, 0, 0, 16), Position = UDim2.fromOffset(16, 46), BackgroundColor3 = T.Bg, Parent = r }, { Kit.corner(8) })
			Kit.new("Frame", { Size = UDim2.fromScale(math.clamp(q.progress / def.goal, 0, 1), 1), BackgroundColor3 = T.Mint, Parent = barBg }, { Kit.corner(8) })
			Kit.label({ Size = UDim2.new(0.2, 0, 0, 20), Position = UDim2.new(0.58, 0, 0, 44), Text = Kit.comma(q.progress) .. "/" .. Kit.comma(def.goal), Font = T.Bold, TextColor3 = T.Sub, MaxText = 15, Parent = r })
			local ready = q.progress >= def.goal and not q.claimed
			local btn = Kit.button({ text = if q.claimed then "CLAIMED" elseif ready then "+" .. def.coins else def.coins .. " coins", color = T.Mint, size = UDim2.fromOffset(150, 52), position = UDim2.new(1, -166, 0.5, -26), parent = r, onClick = function()
				State:Request("claimQuest", q.id)
			end })
			Kit.setEnabled(btn, ready, T.Mint)
		end
	end

	-- Achievements
	local header = row(40)
	header.BackgroundTransparency = 1
	Kit.label({ Size = UDim2.fromScale(1, 1), Text = "ACHIEVEMENTS", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Pink, MaxText = 24, Parent = header })
	for _, a in Progression.Achievements do
		local done = data.achievements[a.id] ~= nil
		local r = row(56)
		r.BackgroundColor3 = if done then T.PanelLight else T.Bg
		Kit.label({ Size = UDim2.new(0.4, 0, 1, -12), Position = UDim2.fromOffset(16, 6), Text = (if done then "[x] " else "[ ] ") .. a.name, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = if done then T.Mint else T.Text, MaxText = 20, Parent = r })
		Kit.label({ Size = UDim2.new(0.58, -16, 1, -12), Position = UDim2.new(0.42, 0, 0, 6), Text = a.desc .. "  (+" .. a.coins .. ")", Font = T.Body, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 15, Parent = r })
	end

	local s = data.stats
	self.stats.Text = string.format("Rounds %s   Wins %s   Trails cut %s   Tiles %s   Best loop %s", Kit.comma(s.rounds), Kit.comma(s.wins), Kit.comma(s.kills), Kit.comma(s.tilesClaimed), Kit.comma(s.bestLoop))
end

function Quests:Start(gui)
	local frame, content = Kit.panel(gui, "QUESTS", UDim2.fromOffset(760, 520))
	self.stats = Kit.label({ Size = UDim2.new(1, 0, 0, 22), Font = T.Bold, TextColor3 = T.Sub, MaxText = 15, Parent = content })
	self.list = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -30),
		Position = UDim2.fromOffset(0, 30),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, { Kit.list(8) })
	Kit.registerModal("Quests", frame, function()
		self:Render()
	end)
	State.ProfileChanged:Connect(function()
		if Kit.currentModal() == "Quests" then
			self:Render()
		end
	end)
end

return Quests
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[-- End-of-round summary: placement, turf, rewards, level-up and the podium.
local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local T = Kit.Theme
local Results = {}

local function ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "st", "nd", "rd" })[n % 10] or "th"
	end
	return n .. suffix
end

function Results:Show(r)
	self.headline.Text = if r.rank == 1 then "YOU WON!" else ordinal(r.rank) .. " of " .. r.count
	self.headline.TextColor3 = if r.rank == 1 then T.Gold elseif r.rank <= 3 then T.Mint else T.Text
	self.stats.Text = string.format("Final turf %.1f%%   Peak %.1f%%   Tiles claimed %s   Trails cut %d", r.percent, r.peak, Kit.comma(r.tiles), r.kills)
	self.rewards.Text = string.format("+%s coins     +%s XP", Kit.comma(r.coins), Kit.comma(r.xp))
	self.levelUp.Visible = r.levelAfter > r.levelBefore
	self.levelUp.Text = "LEVEL UP!  " .. r.levelBefore .. " > " .. r.levelAfter
	for k = 1, 3 do
		local e = r.top[k]
		local l = self.podium[k]
		l.Visible = e ~= nil
		if e then
			l.Text = string.format("%d. %s  %.1f%%", k, e.name, e.percent)
			l.TextColor3 = Color3.fromRGB(e.color[1], e.color[2], e.color[3])
		end
	end
	Kit.openModal("Results")
end

function Results:Start(gui)
	local frame, content = Kit.panel(gui, "ROUND OVER", UDim2.fromOffset(620, 430))
	self.headline = Kit.label({ Size = UDim2.new(1, 0, 0, 70), MaxText = 64, Parent = content })
	self.stats = Kit.label({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 74), Font = T.Bold, TextColor3 = T.Sub, MaxText = 17, Parent = content })
	self.rewards = Kit.label({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 106), TextColor3 = T.Gold, MaxText = 32, Parent = content })
	self.levelUp = Kit.label({ Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 148), TextColor3 = T.Mint, Visible = false, MaxText = 28, Parent = content })
	self.podium = {}
	for k = 1, 3 do
		self.podium[k] = Kit.label({ Size = UDim2.new(1, -40, 0, 30), Position = UDim2.fromOffset(20, 184 + (k - 1) * 34), MaxText = 24, Parent = content })
	end
	Kit.button({ text = "CONTINUE", color = T.Mint, size = UDim2.fromOffset(220, 56), position = UDim2.new(0.5, 0, 1, -8), anchor = Vector2.new(0.5, 1), parent = content, onClick = function()
		Kit.closeModal()
	end })
	Kit.registerModal("Results", frame)
	State.MatchEvent:Connect(function(evt)
		if evt.t == "results" then
			self:Show(evt)
		elseif evt.t == "roundStart" and Kit.currentModal() == "Results" then
			Kit.closeModal()
		end
	end)
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- Settings: volumes, camera mode, reduced effects. Saved server-side with the profile.
local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local T = Kit.Theme
local Settings = { rows = {} }

local function set(key: string, value)
	State.profile.settings[key] = value
	State.ProfileChanged:Fire(State.profile) -- apply instantly, server confirms on next push
	State:Request("setting", { key = key, value = value })
end

function Settings:_row(content, order: number, title: string)
	local r = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = T.PanelLight, LayoutOrder = order, Parent = content }, { Kit.corner(14) })
	Kit.label({ Size = UDim2.new(0.45, 0, 0, 34), Position = UDim2.fromOffset(16, 18), Text = title, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24, Parent = r })
	return r
end

function Settings:_volume(content, order: number, title: string, key: string)
	local r = self:_row(content, order, title)
	local value = Kit.label({ Size = UDim2.fromOffset(80, 34), Position = UDim2.new(1, -196, 0, 18), MaxText = 24, Parent = r })
	local function step(delta)
		local v = math.clamp(math.floor((State.profile.settings[key] + delta) * 10 + 0.5) / 10, 0, 1)
		set(key, v)
	end
	Kit.button({ text = "-", color = T.Sky, size = UDim2.fromOffset(52, 48), position = UDim2.new(1, -256, 0, 11), parent = r, onClick = function()
		step(-0.1)
	end })
	Kit.button({ text = "+", color = T.Sky, size = UDim2.fromOffset(52, 48), position = UDim2.new(1, -108, 0, 11), parent = r, onClick = function()
		step(0.1)
	end })
	self.rows[key] = function(s)
		value.Text = math.floor(s[key] * 100 + 0.5) .. "%"
	end
end

function Settings:_toggle(content, order: number, title: string, key: string, labels, values)
	local r = self:_row(content, order, title)
	local _, label = Kit.button({ text = "", color = T.Mint, size = UDim2.fromOffset(240, 48), position = UDim2.new(1, -256, 0, 11), parent = r, onClick = function()
		local cur = State.profile.settings[key]
		set(key, if cur == values[1] then values[2] else values[1])
	end })
	self.rows[key] = function(s)
		label.Text = if s[key] == values[1] then labels[1] else labels[2]
	end
end

function Settings:Start(gui)
	local frame, content = Kit.panel(gui, "SETTINGS", UDim2.fromOffset(620, 440))
	Kit.list(10).Parent = content
	self:_volume(content, 1, "Sound effects", "sfx")
	self:_volume(content, 2, "Music", "music")
	self:_toggle(content, 3, "Camera", "camera", { "TOP-DOWN", "CLASSIC" }, { "top", "classic" })
	self:_toggle(content, 4, "Effects", "reducedFx", { "REDUCED", "FULL" }, { true, false })
	Kit.registerModal("Settings", frame, function()
		self:Render()
	end)
	State.ProfileChanged:Connect(function()
		self:Render()
	end)
end

function Settings:Render()
	local s = State.profile and State.profile.settings
	if s then
		for _, fn in self.rows do
			fn(s)
		end
	end
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Store: cosmetics for coins, coin packs and passes for Robux. Prices always visible; coin buys confirm;
-- Robux buys use Roblox's own purchase dialog. Never opens by itself.
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Cosmetics = require(ReplicatedStorage.Shared.Cosmetics)
local Progression = require(ReplicatedStorage.Shared.Progression)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local T = Kit.Theme
local Shop = { tab = "ink", livePrices = {} }

local TABS = {
	{ id = "ink", text = "INKS" },
	{ id = "trail", text = "TRAILS" },
	{ id = "title", text = "TITLES" },
	{ id = "coins", text = "COINS" },
	{ id = "passes", text = "PASSES" },
}

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function achievementName(id: string): string
	for _, a in Progression.Achievements do
		if a.id == id then
			return a.name
		end
	end
	return id
end

function Shop:_confirm(text: string, onYes)
	local c = self.confirmFrame
	c.Visible = true
	self.confirmText.Text = text
	self.onConfirm = onYes
end

function Shop:_card(parent, order: number)
	local card = Kit.new("Frame", { Size = UDim2.fromOffset(150, 176), BackgroundColor3 = T.PanelLight, LayoutOrder = order, Parent = parent }, { Kit.corner(14), Kit.stroke(Color3.new(0, 0, 0), 2, 0.6) })
	return card
end

function Shop:_cosmeticCard(parent, item, order: number)
	local data, passes = State.profile, State.passes
	local card = self:_card(parent, order)
	local preview = Kit.new("Frame", { Size = UDim2.fromOffset(70, 70), Position = UDim2.new(0.5, 0, 0, 12), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = T.Bg, Parent = card }, { Kit.corner(35) })
	if item.category == "ink" then
		preview.BackgroundColor3 = rgb(item.color)
		Kit.stroke(Color3.new(1, 1, 1), 3, 0.2).Parent = preview
	else
		Kit.label({ Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Text = if item.category == "trail" then "~" else "Aa", TextColor3 = T.Mint, Parent = preview })
	end
	Kit.label({ Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(6, 88), Text = if item.name == "" then "No Title" else item.name, MaxText = 18, Parent = card })

	local unlocked = Cosmetics.isUnlocked(data, passes, item)
	local equipped = data.equipped[item.category] == item.id
	local u = item.unlock
	local text, color, enabled, action = "EQUIP", T.Mint, true, nil
	if equipped then
		text, enabled = "EQUIPPED", false
	elseif unlocked then
		action = function()
			self:_result(State:Request("equip", item.id))
		end
	elseif u.type == "coins" then
		text, color = "BUY  " .. Kit.comma(u.price), T.Gold
		enabled = data.coins >= u.price
		if not enabled then
			text = Kit.comma(u.price) .. " coins"
		end
		action = function()
			self:_confirm(string.format("Buy %s for %s coins?", item.name, Kit.comma(u.price)), function()
				self:_result(State:Request("buy", item.id))
			end)
		end
	elseif u.type == "level" then
		text, enabled = "LEVEL " .. u.level, false
	elseif u.type == "achievement" then
		text, enabled = achievementName(u.id), false
	elseif u.type == "pass" then
		text, color = "GET PASS", T.Pink
		action = function()
			self.tab = "passes"
			self:Render()
		end
	end
	local btn = Kit.button({ text = text, color = color, size = UDim2.new(1, -16, 0, 40), position = UDim2.new(0, 8, 1, -48), maxText = 16, parent = card, onClick = function()
		State:Event("storeView", item.id)
		if action then
			action()
		end
	end })
	Kit.setEnabled(btn, enabled and action ~= nil, color)
end

function Shop:_price(kind: string, def): string
	if def.id == 0 then
		return "Coming soon"
	end
	local live = self.livePrices[def.id]
	if live == nil then
		self.livePrices[def.id] = false
		task.spawn(function()
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, def.id, if kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product)
			if ok and info and info.PriceInRobux then
				self.livePrices[def.id] = info.PriceInRobux
				if Kit.currentModal() == "Shop" then
					self:Render()
				end
			end
		end)
	end
	return Kit.ROBUX .. " " .. tostring(if live then live else def.price)
end

function Shop:_robuxCard(parent, kind: string, key: string, def, order: number)
	local card = self:_card(parent, order)
	card.Size = UDim2.fromOffset(150, 196)
	local owned = kind == "pass" and State.passes[key]
	local headline = if kind == "product" then Kit.comma(def.coins) .. " coins" else def.name
	Kit.label({ Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 10), Text = headline, TextColor3 = if kind == "product" then T.Gold else T.Pink, MaxText = 20, Parent = card })
	Kit.label({ Size = UDim2.new(1, -16, 0, 88), Position = UDim2.fromOffset(8, 44), Text = if kind == "product" then def.name else def.description, Font = T.Body, TextColor3 = T.Sub, TextWrapped = true, MaxText = 14, Parent = card })
	local text = if owned then "OWNED" else self:_price(kind, def)
	local btn = Kit.button({ text = text, color = if owned then T.Mint else T.Gold, size = UDim2.new(1, -16, 0, 42), position = UDim2.new(0, 8, 1, -50), maxText = 18, parent = card, onClick = function()
		State:Event("storeView", key)
		local res = State:Request("prompt", { kind = kind, key = key })
		if not res.ok and res.err == "unavailable" then
			State.Notify:Fire("This item isn't on sale yet.", "info")
		end
	end })
	Kit.setEnabled(btn, not owned and def.id ~= 0, T.Gold)
end

function Shop:_result(res)
	if res.ok then
		State.Notify:Fire("Done!", "success")
	elseif res.err == "coins" then
		State.Notify:Fire("Not enough coins yet - play a round to earn more!", "info")
	elseif res.err ~= "owned" then
		State.Notify:Fire("Couldn't do that right now.", "info")
	end
end

function Shop:Render()
	if not State.profile then
		return
	end
	for _, c in self.grid:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for _, b in self.tabButtons do
		b.btn.BackgroundColor3 = if b.id == self.tab then T.Sky else T.PanelLight
		b.label.TextColor3 = if b.id == self.tab then Color3.fromRGB(20, 20, 40) else T.Text
	end
	self.coinsLabel.Text = "Your coins: " .. Kit.comma(State.profile.coins)
	local order = 0
	if Cosmetics.Categories[self.tab] then
		for _, item in Cosmetics.Categories[self.tab] do
			order += 1
			self:_cosmeticCard(self.grid, item, order)
		end
	elseif self.tab == "coins" then
		local keys = {}
		for key in Config.Monetization.Products do
			table.insert(keys, key)
		end
		table.sort(keys, function(a, b)
			return Config.Monetization.Products[a].coins < Config.Monetization.Products[b].coins
		end)
		for _, key in keys do
			order += 1
			self:_robuxCard(self.grid, "product", key, Config.Monetization.Products[key], order)
		end
	else
		for _, key in { "VIP", "DoubleCoins", "PrismPack" } do
			order += 1
			self:_robuxCard(self.grid, "pass", key, Config.Monetization.GamePasses[key], order)
		end
	end
	self.note.Visible = self.tab == "coins" or self.tab == "passes"
end

function Shop:Start(gui)
	local frame, content = Kit.panel(gui, "SHOP", UDim2.fromOffset(820, 520))
	local tabs = Kit.new("Frame", { Size = UDim2.new(0, 130, 1, 0), BackgroundTransparency = 1, Parent = content }, { Kit.list(8) })
	self.tabButtons = {}
	for k, tab in TABS do
		local btn, label = Kit.button({ text = tab.text, color = T.PanelLight, textColor = T.Text, size = UDim2.fromOffset(124, 52), layoutOrder = k, maxText = 20, parent = tabs, onClick = function()
			self.tab = tab.id
			self:Render()
		end })
		table.insert(self.tabButtons, { id = tab.id, btn = btn, label = label })
	end
	self.coinsLabel = Kit.label({ Size = UDim2.new(1, -150, 0, 26), Position = UDim2.fromOffset(146, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold, MaxText = 20, Parent = content })
	self.grid = Kit.new("ScrollingFrame", {
		Size = UDim2.new(1, -146, 1, -60),
		Position = UDim2.fromOffset(146, 32),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, {
		Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(150, 196), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Kit.pad(4),
	})
	self.note = Kit.label({ Size = UDim2.new(1, -150, 0, 22), Position = UDim2.new(0, 146, 1, -24), Font = T.Body, TextColor3 = T.Sub, MaxText = 13, Text = "Purchases are optional and cosmetic or coin-boost only - they never decide who wins a round.", Parent = content })

	-- Confirmation dialog for coin purchases.
	local confirm = Kit.new("Frame", { Size = UDim2.fromOffset(420, 190), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.Bg, Visible = false, ZIndex = 5, Parent = frame }, { Kit.corner(18), Kit.stroke(T.Gold, 3, 0) })
	self.confirmText = Kit.label({ Size = UDim2.new(1, -30, 0, 80), Position = UDim2.fromOffset(15, 14), TextWrapped = true, MaxText = 24, Parent = confirm })
	Kit.button({ text = "BUY", color = T.Gold, size = UDim2.fromOffset(160, 52), position = UDim2.new(0.5, -170, 1, -70), parent = confirm, onClick = function()
		confirm.Visible = false
		if self.onConfirm then
			self.onConfirm()
		end
	end })
	Kit.button({ text = "CANCEL", color = T.PanelLight, textColor = T.Text, size = UDim2.fromOffset(160, 52), position = UDim2.new(0.5, 10, 1, -70), parent = confirm, onClick = function()
		confirm.Visible = false
	end })
	self.confirmFrame = confirm

	Kit.registerModal("Shop", frame, function()
		confirm.Visible = false
		State:Event("storeOpen")
		self:Render()
	end)
	State.ProfileChanged:Connect(function()
		if Kit.currentModal() == "Shop" then
			self:Render()
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="54">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
